# RFC 7692's own alphabet, for test/fuzz/wsdeflate_fuzz.cpp (#88).
#
# This target has two halves and this dictionary has two halves. The
# first is a HEADER: a mutator that has to discover the 18 characters
# of "permessage-deflate" one bit at a time never reaches the parameter
# parser at all. The second is DEFLATE: the block headers are three
# bits, so the byte that carries them is worth naming outright.
#
# libFuzzer's dictionary parser knows THREE escapes and no more:
# \\, \" and \xNN. \r and \n are a parse error that aborts the
# whole file, so every control byte below is spelled in hex.

# --- 7692 4.2 / 9110 5.6.1: the extension list's own syntax.
name="permessage-deflate"
sep_semi=";"
sep_comma=","
sep_eq="="
quote="\""
ows=" "
tab="\x09"

# --- 7.1: every parameter, spelled the way an offer spells it.
p_snct="server_no_context_takeover"
p_cnct="client_no_context_takeover"
p_smwb="server_max_window_bits"
p_cmwb="client_max_window_bits"

# --- 7.1.2: the values, and the edges. 8 is the one zlib cannot
# produce for a raw stream; 16 and a leading zero are refusals.
bits_8="=8"
bits_9="=9"
bits_10="=10"
bits_15="=15"
bits_16="=16"
bits_leading_zero="=08"
bits_quoted="=\"12\""

# --- whole offers, so a splice can reach a valid negotiation in one
# move instead of assembling one character at a time.
offer_bare="permessage-deflate"
offer_snct="permessage-deflate; server_no_context_takeover"
offer_cmwb="permessage-deflate; client_max_window_bits"
offer_full="permessage-deflate; server_no_context_takeover; client_no_context_takeover; server_max_window_bits=10; client_max_window_bits=9"
offer_two="permessage-deflate; unknown_thing, permessage-deflate"
offer_other="x-webkit-deflate-frame"

# --- RFC 1951 3.2.3: the block header lives in the low three bits of a
# byte. BFINAL|BTYPE, all six meanings, the last of which is the
# reserved one an inflater must refuse.
blk_stored="\x00"
blk_stored_final="\x01"
blk_fixed="\x02"
blk_fixed_final="\x03"
blk_dynamic="\x04"
blk_dynamic_final="\x05"
blk_reserved="\x06"

# --- 1951 3.2.4 / 7692 7.2.1: a stored block is LEN then ~LEN, and an
# EMPTY one is the four bytes 7692 strips off the end of every message.
stored_empty="\x00\x00\xff\xff"
stored_empty_full="\x00\x00\x00\xff\xff"
stored_len5="\x00\x05\x00\xfa\xff"
stored_len_bad="\x00\x05\x00\x00\x00"

# --- a real, minimal raw-deflate stream: a stored block carrying five
# bytes. The target appends 7.2.2's tail itself, so this is exactly
# what one compressed message looks like on the wire.
msg_hello="\x00\x05\x00\xfa\xffhello"
