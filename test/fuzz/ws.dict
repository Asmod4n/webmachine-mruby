# RFC 6455's own alphabet, for test/fuzz/ws_fuzz.cpp (#88).
#
# A dictionary is not decoration here: the framing's whole shape lives
# in the TOP FIVE BITS of one byte and in three length markers, and a
# mutator flipping bits at random spends most of its budget producing
# frames the parser rejects on byte 0. Handed the legal first bytes, it
# spends that budget past them - on lengths, masks and payloads, which
# is where a framer actually breaks.
#
# libFuzzer's dictionary parser knows THREE escapes and no more:
# \\, \" and \xNN. \r and \n are a parse error that aborts the
# whole file, so every control byte below is spelled in hex.

# --- 5.2: first byte, FIN|RSV|opcode. The whole legal set, plus the
# reserved opcodes and the RSV bits, because refusing them correctly is
# as much a code path as accepting.
fin_text="\x81"
fin_binary="\x82"
fin_cont="\x80"
fin_close="\x88"
fin_ping="\x89"
fin_pong="\x8a"
frag_text="\x01"
frag_binary="\x02"
frag_cont="\x00"
rsv1_text="\xc1"
rsv1_cont="\xc0"
rsv1_ping="\xc9"
rsv2="\xa1"
rsv3="\x91"
reserved_op="\x83"
reserved_op2="\x8b"

# --- 5.2: second byte. The mask bit is MANDATORY client-side (5.1), so
# every length marker appears with it set, and 126/127 name the two
# extended forms whose minimality rules are their own refusals.
mask_len0="\x80"
mask_len125="\xfd"
mask_len16="\xfe"
mask_len64="\xff"
unmasked_len5="\x05"

# --- 5.3: a mask is four bytes; two that make the XOR visible.
mask_zero="\x00\x00\x00\x00"
mask_ffff="\xff\xff\xff\xff"

# --- 5.2: extended lengths, including the non-minimal spellings that
# must be refused (126 written as 16-bit, 0xffff written as 64-bit).
len16_min="\xfe\x00\x7e"
len16_nonminimal="\xfe\x00\x05"
len64_min="\xff\x00\x00\x00\x00\x00\x01\x00\x00"
len64_nonminimal="\xff\x00\x00\x00\x00\x00\x00\xff\xff"
len64_highbit="\xff\x80\x00\x00\x00\x00\x00\x00\x00"

# --- 7.4.1: close codes, big-endian, the ones a peer may send and the
# ones it may not.
close_1000="\x03\xe8"
close_1001="\x03\xe9"
close_1002="\x03\xea"
close_1007="\x03\xef"
close_1009="\x03\xf1"
close_1005_illegal="\x03\xed"
close_1006_illegal="\x03\xee"
close_999_illegal="\x03\xe7"
close_3000="\x0b\xb8"

# --- 8.1: UTF-8 boundaries, the ones RFC 3629 draws and Autobahn 6.x
# tests - a lead byte with no continuation, an overlong form, a
# surrogate, and past the last code point.
utf8_2byte="\xc2\xa2"
utf8_3byte="\xe2\x82\xac"
utf8_4byte="\xf0\x9f\x92\xa9"
utf8_lead_alone="\xc2"
utf8_overlong="\xc0\x80"
utf8_surrogate="\xed\xa0\x80"
utf8_too_high="\xf4\x90\x80\x80"
utf8_f5="\xf5\x80\x80\x80"
