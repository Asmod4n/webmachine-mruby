diff --git a/src/wrk.c b/src/wrk.c
index 51f46f7..dbe8290 100644
--- a/src/wrk.c
+++ b/src/wrk.c
@@ -1,6 +1,7 @@
 // Copyright (C) 2012 - Will Glozer.  All rights reserved.
 
 #include "wrk.h"
+#include <sys/un.h>
 #include "script.h"
 #include "main.h"
 
@@ -15,6 +16,10 @@ static struct config {
     bool     latency;
     char    *host;
     char    *script;
+    /* --unix PATH: every connection goes to this AF_UNIX socket. The URL
+       is still parsed and still supplies the request path and the Host
+       header - only the ADDRESS comes from here instead of a resolver. */
+    char    *unix_path;
     SSL_CTX *ctx;
 } cfg;
 
@@ -45,6 +50,7 @@ static void usage() {
     printf("Usage: wrk <options> <url>                            \n"
            "  Options:                                            \n"
            "    -c, --connections <N>  Connections to keep open   \n"
+           "    -U, --unix        <P>  Connect over this AF_UNIX path\n"
            "    -d, --duration    <T>  Duration of test           \n"
            "    -t, --threads     <N>  Number of threads to use   \n"
            "                                                      \n"
@@ -93,6 +99,18 @@ int main(int argc, char **argv) {
     thread *threads     = zcalloc(cfg.threads * sizeof(thread));
 
     lua_State *L = script_create(cfg.script, url, headers);
+    /* wrk.resolve probes every resolved address with a connect and drops
+       the ones nothing answers on. With --unix that address is not where
+       the load is going, so the probe would refuse a run that is perfectly
+       able to proceed - the flag below turns it off. The URL is still
+       resolved, because wrk.addrs must hold something and the Host header
+       still comes from the URL. */
+    if (cfg.unix_path) {
+        lua_getglobal(L, "wrk");
+        lua_pushboolean(L, 1);
+        lua_setfield(L, -2, "unix");
+        lua_pop(L, 1);
+    }
     if (!script_resolve(L, host, service)) {
         char *msg = strerror(errno);
         fprintf(stderr, "unable to connect to %s:%s %s\n", host, service, msg);
@@ -238,6 +256,20 @@ static int connect_socket(thread *thread, connection *c) {
     struct aeEventLoop *loop = thread->loop;
     int fd, flags;
 
+    if (cfg.unix_path) {
+        struct sockaddr_un un;
+        memset(&un, 0, sizeof(un));
+        un.sun_family = AF_UNIX;
+        strncpy(un.sun_path, cfg.unix_path, sizeof(un.sun_path) - 1);
+        if ((fd = socket(AF_UNIX, SOCK_STREAM, 0)) < 0) goto error;
+        flags = fcntl(fd, F_GETFL, 0);
+        fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+        if (connect(fd, (struct sockaddr *) &un, sizeof(un)) == -1 && errno != EINPROGRESS) {
+            goto error;
+        }
+        goto armed;
+    }
+
     fd = socket(addr->ai_family, addr->ai_socktype, addr->ai_protocol);
 
     flags = fcntl(fd, F_GETFL, 0);
@@ -250,6 +282,8 @@ static int connect_socket(thread *thread, connection *c) {
     flags = 1;
     setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &flags, sizeof(flags));
 
+  armed:
+
     flags = AE_READABLE | AE_WRITABLE;
     if (aeCreateFileEvent(loop, fd, flags, socket_connected, c) == AE_OK) {
         c->parser.data = c;
@@ -468,6 +502,7 @@ static char *copy_url_part(char *url, struct http_parser_url *parts, enum http_p
 
 static struct option longopts[] = {
     { "connections", required_argument, NULL, 'c' },
+    { "unix",        required_argument, NULL, 'U' },
     { "duration",    required_argument, NULL, 'd' },
     { "threads",     required_argument, NULL, 't' },
     { "script",      required_argument, NULL, 's' },
@@ -489,7 +524,7 @@ static int parse_args(struct config *cfg, char **url, struct http_parser_url *pa
     cfg->duration    = 10;
     cfg->timeout     = SOCKET_TIMEOUT_MS;
 
-    while ((c = getopt_long(argc, argv, "t:c:d:s:H:T:Lrv?", longopts, NULL)) != -1) {
+    while ((c = getopt_long(argc, argv, "t:c:d:s:H:T:U:Lrv?", longopts, NULL)) != -1) {
         switch (c) {
             case 't':
                 if (scan_metric(optarg, &cfg->threads)) return -1;
@@ -503,6 +538,9 @@ static int parse_args(struct config *cfg, char **url, struct http_parser_url *pa
             case 's':
                 cfg->script = optarg;
                 break;
+            case 'U':
+                cfg->unix_path = optarg;
+                break;
             case 'H':
                 *header++ = optarg;
                 break;
diff --git a/src/wrk.lua b/src/wrk.lua
index 0229fdf..bb85116 100644
--- a/src/wrk.lua
+++ b/src/wrk.lua
@@ -11,9 +11,15 @@ local wrk = {
 
 function wrk.resolve(host, service)
    local addrs = wrk.lookup(host, service)
-   for i = #addrs, 1, -1 do
-      if not wrk.connect(addrs[i]) then
-         table.remove(addrs, i)
+   -- The probe connect is what drops an address nothing answers on. With
+   -- --unix the address is not where we are going anyway, so probing it
+   -- would refuse a run that is perfectly able to proceed - and that is
+   -- why a unix run used to need a dummy TCP listener beside it.
+   if not wrk.unix then
+      for i = #addrs, 1, -1 do
+         if not wrk.connect(addrs[i]) then
+            table.remove(addrs, i)
+         end
       end
    end
    wrk.addrs = addrs
